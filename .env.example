# Copy this file to .env. Never commit .env or paste its values into chat.
APP_ENV=development
APP_NAME=AgentCare
BASE_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///./var/agentcare.db
AUTO_CREATE_TABLES=true

# Generate a long random value before any public deployment.
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=28800

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
MAX_AGENT_RETRIES=3
MAX_WORKFLOW_STEPS=12

UPLOAD_DIR=./var/uploads
STAGING_DIR=./var/staging
MAX_UPLOAD_MB=8
TIMEZONE=Asia/Kolkata
EMERGENCY_NUMBER=112
DEMO_MODE=true
SEED_DEMO_DATA=true

# Synthetic demo identities. Change passwords in a deployed environment.
DEMO_PATIENT_EMAIL=asha.patient@example.test
DEMO_PATIENT_PASSWORD=change-me-patient
DEMO_STAFF_EMAIL=meera.staff@example.test
DEMO_STAFF_PASSWORD=change-me-staff
